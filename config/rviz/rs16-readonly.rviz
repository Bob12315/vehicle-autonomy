Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 25; 35
    Fixed Frame: lidar
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Lidar frame grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RS16 live points
      Enabled: true
      Topic:
        Value: /vaf/lidar/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 220; 195
      Style: Points
      Size (Pixels): 2
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: RS16 planar scan
      Enabled: true
      Topic:
        Value: /vaf/lidar/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 190; 80
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Value: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 0.8
      Yaw: 0.5
      Focal Point: {X: 0, Y: 0, Z: 0}
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1280
  Height: 800

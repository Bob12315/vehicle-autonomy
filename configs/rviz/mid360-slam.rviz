Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 24; 29; 38
    Fixed Frame: __WORLD__
    Frame Rate: 10
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Local LIO map (not globally aligned)
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 80
  - Class: rviz_default_plugins/PointCloud2
    Name: FAST-LIO2 registered __SOURCE__
    Enabled: true
    Topic:
      Value: __NS__/registered
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Style: Points
    Size (Pixels): 3
    Decay Time: 0.3
  - Class: rviz_default_plugins/PointCloud2
    Name: Accumulated estimated voxel map
    Enabled: true
    Topic:
      Value: __NS__/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 5
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw points in LIO sensor pose
    Enabled: false
    Topic:
      Value: __NS__/raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Style: Points
    Size (Pixels): 3
    Decay Time: 0.3
  - Class: rviz_default_plugins/RobotModel
    Name: Schematic vehicle and actual sensor mount
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: __NS__/robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    TF Prefix: ''
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/TF
    Name: LIO adapter single-authority TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: true
  - Class: rviz_default_plugins/Path
    Name: Estimated bounded LIO trajectory
    Enabled: true
    Topic:
      Value: __NS__/trajectory
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Line Style: Lines
    Line Width: 0.03
    Color: 255; 190; 70
  - Class: rviz_default_plugins/PointCloud2
    Name: SC-PGO optimized historical keyframe map
    Enabled: __PGO_ENABLED__
    Topic:
      Value: __NS__/pgo_map_display
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 5
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Use Fixed Frame: true
    Style: Points
    Size (Pixels): 3
    Decay Time: 0
  - Class: rviz_default_plugins/Path
    Name: SC-PGO optimized IMU keyframe trajectory
    Enabled: __PGO_ENABLED__
    Topic:
      Value: __NS__/pgo_path_display
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Line Style: Lines
    Line Width: 0.03
    Color: 80; 210; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: Matched saved map (display alone is not localization)
    Enabled: __RELOCATED_ENABLED__
    Topic:
      Value: __NS__/loaded_map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Style: Points
    Size (Pixels): 2
    Decay Time: 0
  - Class: rviz_default_plugins/Path
    Name: Capture-stamped matched map trajectory
    Enabled: __RELOCATED_ENABLED__
    Topic:
      Value: __NS__/relocated_trajectory
      Reliability Policy: Reliable
      Depth: 5
    Line Style: Lines
    Line Width: 0.04
    Color: 80; 240; 180
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Pitch: 0.65
      Yaw: 0.6
      Target Frame: __BASE__
Window Geometry:
  Width: 1280
  Height: 800

# Optional user service template. Never installed/enabled automatically.
[Unit]
Description=Vehicle Autonomy receive-only diagnostics

[Service]
Type=simple
Environment=VAF_RESOURCE_ROOT=/home/pi/vehicle-autonomy/current
WorkingDirectory=/home/pi/vehicle-autonomy/current
ExecStart=/home/pi/vehicle-autonomy/venv/bin/python -m vehicle_autonomy.app.bootstrap.onboard supervise
Restart=no
NoNewPrivileges=true
UMask=0077
TimeoutStopSec=15

[Install]
WantedBy=default.target

+// Original received IMU stamps only. No estimator state, sensor values,
+// time offsets, interpolation, or optimization mathematics are changed.
+void vaf_publish_input_timing(const MeasureGroup & meas,
+    const rclcpp::Publisher<std_msgs::msg::String>::SharedPtr & publisher)
+{
+    const auto begin_msg = get_ros_time(meas.lidar_beg_time);
+    const auto end_msg = get_ros_time(meas.lidar_end_time);
+    const int64_t begin = begin_msg.nanoseconds();
+    const int64_t end = end_msg.nanoseconds();
+    std::ostringstream payload;
+    payload << "{\"source_begin_ns\":" << begin << ",\"source_end_ns\":" << end << ",\"imu_capture_times_ns\":[";
+    bool first = true;
+    {
+        std::lock_guard<std::mutex> guard(mtx_buffer);
+        for (const int64_t stamp : vaf_received_imu_times) {
+            if (stamp < begin - 20000000 || stamp > end + 20000000) continue;
+            if (!first) payload << ',';
+            payload << stamp;
+            first = false;
+        }
+    }
+    payload << "],\"point_capture_times_ns\":[";
+    std::set<int64_t> point_times;
+    for (const auto & point : meas.lidar->points) {
+        point_times.insert(begin + static_cast<int64_t>(std::llround(point.curvature * 1000000.0)));
+    }
+    first = true;
+    for (const int64_t stamp : point_times) {
+        if (!first) payload << ',';
+        payload << stamp;
+        first = false;
+    }
+    payload << "],\"retained_points\":" << meas.lidar->points.size() << "}";
+    std_msgs::msg::String message;
+    message.data = payload.str();
+    publisher->publish(message);
+}

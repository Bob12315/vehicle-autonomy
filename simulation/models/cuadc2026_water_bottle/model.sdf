<?xml version="1.0"?>
<sdf version="1.9">
  <model name="cuadc2026_water_bottle">
    <!--
      SIMULATION-ONLY NEAR-ZERO MASS.
      Payload weight is intentionally not modeled.
      This bottle is used only for drop / collision visualization.
    -->
    <link name="bottle_link">
      <!-- The model origin is at the cylindrical body centre of mass; +Z is up. -->
      <inertial>
        <mass>0.001</mass>
        <!-- Solid cylinder: m=0.001 kg, r=0.0325 m, h=0.22 m. -->
        <inertia>
          <ixx>0.000004297395833333333</ixx>
          <iyy>0.000004297395833333333</iyy>
          <izz>0.000000528125</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="bottle_collision">
        <geometry><cylinder><radius>0.0325</radius><length>0.22</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <bounce><restitution_coefficient>0.05</restitution_coefficient><threshold>0.1</threshold></bounce>
        </surface>
      </collision>
      <visual name="bottle_visual">
        <geometry><cylinder><radius>0.0325</radius><length>0.22</length></cylinder></geometry>
        <material><ambient>0.12 0.45 0.85 1</ambient><diffuse>0.12 0.45 0.85 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>

<sensor name="preview_front" type="camera">
  <pose>0.30 0 0.30 0 0 0</pose>
  <always_on>true</always_on><update_rate>10</update_rate>
  <camera><horizontal_fov>1.25</horizontal_fov>
    <image><width>640</width><height>480</height><format>R8G8B8</format></image>
    <clip><near>0.05</near><far>80</far></clip>
  </camera>
</sensor>

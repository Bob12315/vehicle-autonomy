# Owned conventional Plane/Gazebo fixture; no hardware configuration.
MAV1_POSITION 10
MAV1_EXTRA1 10
MAV1_EXTRA2 5
MAV1_EXT_STAT 5
MAV1_EXTRA3 2
SERVO3_MIN 1100
SERVO3_MAX 1900
SERVO3_TRIM 1100
ARSPD_TYPE 0
ARSPD_USE 0
# Native takeoff and native AUTOLAND, no VTOL or mission bypass.
TKOFF_ALT 50
TKOFF_DIST 300
TKOFF_LVL_PITCH 12
TKOFF_ROTATE_SPD 12
TKOFF_THR_MINSPD 0
TKOFF_THR_MINACC 0
AIRSPEED_CRUISE 17
AIRSPEED_MIN 10
AIRSPEED_MAX 28
TRIM_THROTTLE 45
WP_LOITER_RAD 80
# ArduPlane at the pinned revision expresses RTL_ALTITUDE in metres.
RTL_ALTITUDE 50
AUTOLAND_WP_DIST 400
AUTOLAND_WP_ALT 40
LAND_DISARMDELAY 5
# Native containment remains active independently of the companion link.
FENCE_ENABLE 1
FENCE_TYPE 3
FENCE_ACTION 1
FENCE_RADIUS 2000
FENCE_ALT_MAX 150
FENCE_ALT_MAX_TP 1

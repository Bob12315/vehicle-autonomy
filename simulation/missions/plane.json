{
  "schema_version": 1,
  "id": "plane-mission",
  "name": "plane physical Mission",
  "version": "1.0.0",
  "target": "plane",
  "root": "root",
  "nodes": [
    {
      "id": "root",
      "type": "Sequence",
      "children": [
        "step1",
        "step2",
        "step3",
        "step4",
        "step5",
        "wait5",
        "step7",
        "wait7",
        "step9",
        "wait9",
        "step11"

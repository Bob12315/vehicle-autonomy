    },
    {
      "edge_id": "e_condition_true_confirmed",
      "source": "condition",
      "target": "confirmed",
      "port": "true"
    },
    {
      "edge_id": "e_condition_false_armed",
      "source": "condition",
      "target": "armed",
      "port": "false"
    },
    {
      "edge_id": "e_condition_unknown_unknown",
      "source": "condition",
      "target": "unknown",
      "port": "unknown"
    },
    {
      "edge_id": "e_condition_next_end",
      "source": "condition",
      "target": "end",
      "port": "next"
    }
  ],
  "metadata": {
    "tags": [
      "simulation",
      "standard-example"
    ],
    "description": "只检查三秒内新鲜的解锁状态：已上锁走成功，已解锁走失败，缺失或过期走 UNKNOWN；不代表整车或起飞资格。",

    {
      "node_id": "armed",
      "type": "End",
      "execution_policy": {
        "outcome": "FAILED"
      }
    },
    {
      "node_id": "unknown",
      "type": "End",
      "execution_policy": {
        "outcome": "UNKNOWN"
      }
    },
    {
      "node_id": "end",
      "type": "End"
    }
  ],
  "edges": [
    {
      "edge_id": "e_start_next_snapshot",
      "source": "start",
      "target": "snapshot",
      "port": "next"
